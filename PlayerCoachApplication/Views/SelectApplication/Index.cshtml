    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    if (Model.AvailableSports != null && Model.SelectedSportName == null)
    {
        <div class="d-flex justify-content-center align-items-center vh-25">
            <div class="text-center">
                <h1 class="text-center">Select Your Sport</h1>

                <form method="post" asp-controller="SelectApplication" asp-action="Index">
                    <div class="mb-3">
                        <label class="form-label" for="SelectedSportName">Sport</label>
                        <select id="SelectedSportName" name="selectedSport" class="form-select">
                            <option value="">-- Select Sport --</option>
                            @if (Model?.AvailableSports != null)
                            {
                                foreach (var sport in Model.AvailableSports)
                                {
                                    <option value="@sport">@sport</option>
                                }
                            }
                        </select>
                    </div>
                        <br/><br/>
                        <select id="role" name="selectedRole" required>
                        <option value="">-- Select Role --</option>
                        <option value="Coach">Coach</option>
                        <option value="Player">Player</option>
                        </select>
                        <br/><br/>
                    <button type="submit" class="btn btn-primary">Submit</button>
                 </form>
            </div>
         </div>

            

    }
    else if (Model != null && Model.SelectedSportName != null && Model.SelectedRole == null)
    {
        <div class="d-flex justify-content-center align-items-center vh-25">
            <div class="text-center">
                <h1 class="text-center">Select Your Role</h1>

                <form method="post" asp-controller="SelectApplication" asp-action="Index">
                    <input type="hidden" name="selectedSport" value="@Model.SelectedSportName" />
                    <select id="role" name="selectedRole">
                        <option value="Coach">Coach</option>
                        <option value="Player">Player</option>
                    </select>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </div>
    }
    else if (Model != null && Model.SelectedSportName != null && Model.SelectedRole != null)
    {
        if (Model.SelectedRole == "Coach")
        {
            <h1 class="text-center">Your Selection</h1>
            <div class="text-center">

                <form method="get" asp-controller="CoachApplication" asp-action="Index">
                    <input type="hidden" name="selectedSportName" value="@Model.SelectedSportName" />
                    <input type="hidden" name="selectedRole" value="@Model.SelectedRole" />
                    <button type="submit" class="btn btn-success">Go to Application</button>
                </form>
            </div>
        }
        else
        {
            <h1 class="text-center">Your Selection</h1>
                <div class="text-center">
        <form method="get" asp-controller="PlayerApplication" asp-action="Index">
                <input type="hidden" name="selectedSportName" value="@Model.SelectedSportName" />
                <input type="hidden" name="selectedRole" value="@Model.SelectedRole" />
                <button type="submit" class="btn btn-success">Go to Application</button>
            </form>
            </div>
        }
        

    }
}

@* This code creates a web page that guides users through selecting a sport and a role, then directs them to the correct application form.
How it works:
•	If no selection has been made (Model == null), it shows a dropdown for the user to pick a sport (Football, Basketball, Baseball, Hockey, Soccer).
•	If a sport is selected but no role is chosen, it shows a dropdown for the user to pick a role (Coach or Player).
•	If both a sport and a role are selected:
•	If the role is "Coach", it shows a button to go to the coach application form for the chosen sport.
•	If the role is "Player", it shows a button to go to the player application form for the chosen sport.
In short:
This page helps users choose a sport and a role step-by-step, then sends them to the right application form based on their choices.
 *@