@model PlayerCoachApplication.Data.Models.CoachApplicationModel

@{
    ViewData["Title"] = "Edit Player Application";
    Layout = "_Layout";
}

<h2>Edit Coach Application</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control" required />
        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="YearsOfExperience" class="form-label"></label>
        <input asp-for="YearsOfExperience" type="number" class="form-control" required />
        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <select asp-for="SelectedSportName" class="form-control">
            <option value="">-- Select Sport --</option>
            @foreach (var sport in Model.Sport)
            {
                <option value="@sport">@sport</option>
            }
        </select>

        @* <label asp-for="SelectedSportName" class="form-label"></label>
        <select asp-for="SelectedSportName" asp-items="Model.Sports" class="form-control">
            <option value="">-- Select Sport --</option>
        </select> *@
    </div>
        <button type="submit" class="btn btn-primary">Save</button>
</form>

