@{
   
}

<h1> Welcome to the Coach Application</h1>
<p>Sport: @Model.SelectedSportName</p>
<p>Sport: @Model.SelectedRole</p>

<form method="post" asp-controller="CoachApplication" asp-action= "Index">
    <input type="hidden" name="selectedSportName" value="@Model.SelectedSportName" />
    <input type="hidden" name="selectedRole" value="@Model.SelectedRole" />
    <div>
        <label for="FirstName">First Name</label>
        <input type="text" Name="FirstName" class="form-control" value="" required/>
    </div>

    <div>
        <label for="LastName">Last Name</label>
        <input type="text" Name="LastName" class="form-control" value="" required/>
    </div>

    <div>
        <label for="DateOfBirth">Date Of Birth</label>
        <input type="date" Name="DateOfBirth" class="form-control" value="" required/>
    </div>


    <div>
        <label for="YearsOfExperience">Years Of Experience</label>
        <input type="number" Name="YearsExperience" class="form-control" value="" required />
    </div>

      <button type="submit" class="btn btn-primary">Submit</button>
</form>

       @*  This code creates a web page for submitting a coach application.
What it does:
•	Displays a welcome message.
•	Shows the selected sport and role from the model.
•	Contains a form for the user to enter:
•	First Name
•	Last Name
•	Date of Birth
•	Years of Experience
•	Includes hidden fields to keep the selected sport and role values.
•	When the form is submitted, it sends the data to the Index action of the CoachApplication controller.
In short:
This page lets users fill out and submit a coach application, including their personal details and the sport/role they selected earlier.
 *@