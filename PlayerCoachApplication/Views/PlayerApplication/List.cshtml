@model IEnumerable<PlayerCoachApplication.Data.Models.PlayerApplicationModel>
@{
    ViewData["Title"] = "Player Applications";
    Layout = "_Layout";
    var Sports = ViewBag.Sports as List<string>;
    var selectedSport = ViewBag.SelectedSport as string;
}
<h2>Player Applications</h2>

<form method="post" asp-controller="PlayerApplication" asp-action="List">
    <select id="sport" name="SelectedSport">1
         <option value="Football">Football</option>
        <option value="Basketball">Basketball</option>
        <option value="Baseball">Baseball</option>
        <option value="Hockey">Hockey</option>
        <option value="Soccer">Soccer</option>
    </select>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>


<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date Of Birth</th>
            <th>Sport</th>
            <th>Preferred Position</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.FirstName</td>
                <td>@app.LastName</td>
                <td>@(app.DateOfBirth?.ToShortDateString() ?? "N/A")</td>
                <td>@app.SelectedSportName
                <td>@app.PreferredPosition</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@app.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@app.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm" ('Are you sure you want to delete this application?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
