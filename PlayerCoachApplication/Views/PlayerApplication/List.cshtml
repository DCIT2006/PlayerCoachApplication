@model IEnumerable<PlayerCoachApplication.Data.Models.PlayerApplicationModel>
@{
    ViewData["Title"] = "Player Applications";
    Layout = "_Layout";
    var Sports = ViewBag.Sports as List<string>;
    var selectedSport = ViewBag.SelectedSport as string;
}
<h2>Player Applications</h2>

<form method="post" asp-controller="PlayerApplication" asp-action="List">
    <select id="sport" name="SelectedSport">1
         <option value="Football">Football</option>
        <option value="Basketball">Basketball</option>
        <option value="Baseball">Baseball</option>
        <option value="Hockey">Hockey</option>
        <option value="Soccer">Soccer</option>
    </select>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>


<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Date Of Birth</th>
            <th>Sport</th>
            <th>Preferred Position</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.FirstName</td>
                <td>@app.LastName</td>
                <td>@(app.DateOfBirth?.ToShortDateString() ?? "N/A")</td>
                <td>@app.SelectedSportName
                <td>@app.PreferredPosition</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@app.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@app.Id" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm" ('Are you sure you want to delete this application?');">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@* This code creates a web page that displays a list of player applications and lets users filter, edit, or delete them.
What it does:
•	Sets up the page with a title and layout.
•	Shows a heading: "Player Applications".
•	Displays a dropdown menu to filter applications by sport (Football, Basketball, Baseball, Hockey, Soccer) and a submit button.
•	When the form is submitted, it sends the selected sport to the server to filter the list.
•	Shows a table listing all player applications, with columns for:
•	First Name
•	Last Name
•	Date Of Birth
•	Sport
•	Preferred Position
•	For each application, provides:
•	An "Edit" button to update the application.
•	A "Delete" button to remove the application (with a confirmation prompt).
In short:
This page lets users view all player applications, filter them by sport, and edit or delete individual applications.

 *@