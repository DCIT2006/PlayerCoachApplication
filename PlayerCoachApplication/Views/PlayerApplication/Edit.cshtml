@model PlayerCoachApplication.Models.EditPlayerApplicationModel

@{
    ViewData["Title"] = "Edit Player Application";
    Layout = "_Layout";
}

<h2>Edit Player Application</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="PlayerApplicationModel.Id" />
    <div class="mb-3">
        <label asp-for="PlayerApplicationModel.FirstName" class="form-label"></label>
        <input asp-for="PlayerApplicationModel.FirstName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PlayerApplicationModel.LastName" class="form-label"></label>
        <input asp-for="PlayerApplicationModel.LastName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PlayerApplicationModel.DateOfBirth" class="form-label"></label>
        <input asp-for="PlayerApplicationModel.DateOfBirth" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="PlayerApplicationModel.SelectedSportName" class="form-label"></label>
        <select id="sport" name="SelectedSportName">
            <option value="Football">Football</option>
            <option value="Basketball">Basketball</option>
            <option value="Baseball">Baseball</option>
            <option value="Hockey">Hockey</option>
            <option value="Soccer">Soccer</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="PlayerApplicationModel.SelectedRole" class="form-label"></label>
        <input asp-for="PlayerApplicationModel.SelectedRole" class="form-control" />
    </div>

    <label for="PreferredPosition">Preferred Position</label>
    <select name="PreferredPosition" class="form-control" id="PreferredPosition">
        <option value="">-- Select Positiion --</option>
        @if (@Model.PlayerApplicationModel.SelectedSportName == "Football")

        {
            
            @if (@Model.FootballPositions != null)
            {
                foreach (var pos in Model.FootballPositions)
                {
                    <option value="@pos" selected="@(Model.PlayerApplicationModel.PreferredPosition == pos ? "selected" : null)">@pos</option>
                }
            }
        }
        @if (@Model.PlayerApplicationModel.SelectedSportName == "Basketball")
        {
            @if (@Model.BasketballPositions != null)
            {
                foreach (var pos in Model.BasketballPositions)
                {
                    <option value="@pos" selected="@(Model.PlayerApplicationModel.PreferredPosition == pos ? "selected" : null)">@pos</option>
                }
            }
        }

        <button type="submit" class="btn btn-primary">Save</button>
</form>

